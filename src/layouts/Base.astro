---
import '../styles/global.css';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  og?: { title?: string; description?: string; type?: string };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  og = {},
  jsonLd,
  breadcrumbs,
} = Astro.props;

const siteName = 'gdzie-konferencje.pl';
const ogTitle = og.title ?? title;
const ogDescription = og.description ?? description;
const ogType = og.type ?? 'website';

const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://gdzie-konferencje.pl/' },
        ...breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: b.name,
          item: b.url,
        })),
      ],
    }
  : null;

const allSchemas = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
];

const specializations = [
  { name: 'Stomatologia', href: '/konferencje/stomatologia/' },
  { name: 'Implantologia', href: '/konferencje/implantologia/' },
  { name: 'Protetyka', href: '/konferencje/protetyka/' },
  { name: 'Stomatologia estetyczna', href: '/konferencje/stomatologia-estetyczna/' },
  { name: 'Ortodoncja', href: '/konferencje/ortodoncja/' },
  { name: 'Chirurgia stomatologiczna', href: '/konferencje/chirurgia-stomatologiczna/' },
  { name: 'Periodontologia', href: '/konferencje/periodontologia/' },
  { name: 'Endodoncja', href: '/konferencje/endodoncja/' },
  { name: 'Stomatologia dziecięca', href: '/konferencje/stomatologia-dziecieca/' },
];

const cities = [
  { name: 'Warszawa', href: '/konferencje/miasto/warszawa/' },
  { name: 'Kraków', href: '/konferencje/miasto/krakow/' },
  { name: 'Gdańsk', href: '/konferencje/miasto/gdansk/' },
  { name: 'Wrocław', href: '/konferencje/miasto/wroclaw/' },
  { name: 'Poznań', href: '/konferencje/miasto/poznan/' },
  { name: 'Łódź', href: '/konferencje/miasto/lodz/' },
  { name: 'Katowice', href: '/konferencje/miasto/katowice/' },
  { name: 'Lublin', href: '/konferencje/miasto/lublin/' },
  { name: 'Bydgoszcz', href: '/konferencje/miasto/bydgoszcz/' },
  { name: 'Szczecin', href: '/konferencje/miasto/szczecin/' },
  { name: 'Rzeszów', href: '/konferencje/miasto/rzeszow/' },
  { name: 'Białystok', href: '/konferencje/miasto/bialystok/' },
  { name: 'Olsztyn', href: '/konferencje/miasto/olsztyn/' },
  { name: 'Kielce', href: '/konferencje/miasto/kielce/' },
  { name: 'Opole', href: '/konferencje/miasto/opole/' },
  { name: 'Zielona Góra', href: '/konferencje/miasto/zielona-gora/' },
];
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {allSchemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
    )}
  </head>
  <body class="bg-white text-slate-800 antialiased">

    <!-- DISCLAIMER MODAL -->
    <div
      id="disclaimer-modal"
      class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/80 p-4 backdrop-blur-sm"
    >
      <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-2xl">
        <div class="flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="6" fill="#075985"/>
            <rect x="13" y="5" width="6" height="11" rx="3" fill="white"/>
            <path d="M9 14 Q9 21 16 21 Q23 21 23 14" stroke="white" stroke-width="2" fill="none" stroke-linecap="round"/>
            <line x1="16" y1="21" x2="16" y2="26" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <line x1="11" y1="26" x2="21" y2="26" stroke="white" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span class="font-bold text-brand-800">gdzie-konferencje.pl</span>
        </div>
        <h2 class="mt-4 text-xl font-bold text-slate-900">Serwis dla profesjonalistów</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Portal gdzie-konferencje.pl skierowany jest do lekarzy dentystów, techników dentystycznych oraz przedstawicieli branży medycznej. Zamieszczone treści mają charakter edukacyjny i zawodowy, przeznaczony dla wykwalifikowanych pracowników ochrony zdrowia.
        </p>
        <p class="mt-4 text-sm font-semibold text-slate-800">
          Czy jesteś lekarzem dentystą, technikiem dentystycznym lub pracownikiem branży medycznej?
        </p>
        <div class="mt-5 flex flex-col gap-3">
          <button
            id="disclaimer-yes"
            class="w-full rounded-lg bg-brand-700 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
          >
            Tak, jestem lekarzem / pracownikiem medycznym
          </button>
          <button
            id="disclaimer-no"
            class="w-full rounded-lg border border-slate-200 px-4 py-3 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-50"
          >
            Nie, opusc strone
          </button>
        </div>
        <p class="mt-5 text-xs leading-relaxed text-slate-400">
          Wejscie na strone jest rownoznaczne z oswiadczeniem, ze jestes lekarzem dentysta, technikiem dentystycznym lub pracownikiem branzy medycznej. Portal nie swiadczy uslug medycznych i nie zastepuje porady lekarskiej.
        </p>
      </div>
    </div>

    <!-- HEADER -->
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">

        <!-- Logo -->
        <a href="/" class="flex flex-col leading-none">
          <span class="text-[10px] font-light uppercase tracking-[0.35em] text-slate-400">gdzie</span>
          <span class="text-[19px] font-extrabold tracking-tight text-brand-800">konferencje</span>
        </a>

        <!-- Desktop Nav (right-aligned) -->
        <nav class="hidden items-center gap-0.5 lg:flex">

          <!-- Konferencje dropdown -->
          <div class="group relative">
            <button class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-brand-700">
              Konferencje
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="invisible absolute left-0 top-full z-50 mt-1 w-64 rounded-xl border border-slate-100 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 group-hover:visible group-hover:opacity-100">
              <p class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Specjalizacje</p>
              {specializations.map(s => (
                <a href={s.href} class="block rounded-lg px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700">
                  {s.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Miasta dropdown -->
          <div class="group relative">
            <button class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-brand-700">
              Miasta
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="invisible absolute left-0 top-full z-50 mt-1 w-44 rounded-xl border border-slate-100 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 group-hover:visible group-hover:opacity-100">
              <p class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Wybierz miasto</p>
              {cities.map(c => (
                <a href={c.href} class="block rounded-lg px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700">
                  {c.name}
                </a>
              ))}
            </div>
          </div>

          <a href="/blog/" class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-brand-700">
            Blog
          </a>
        </nav>

        <!-- Right: hamburger -->
        <div class="flex items-center gap-2">
          <button
            id="menu-toggle"
            class="rounded-md p-2 text-slate-600 transition-colors hover:bg-slate-100 lg:hidden"
            aria-label="Otworz menu"
          >
            <svg id="icon-open" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white px-4 pb-5 lg:hidden">
        <div class="mt-3 space-y-0.5">
          <p class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Specjalizacje</p>
          {specializations.map(s => (
            <a href={s.href} class="block rounded-lg px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700">
              {s.name}
            </a>
          ))}
          <p class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Miasta</p>
          <div class="grid grid-cols-2 gap-0.5">
            {cities.map(c => (
              <a href={c.href} class="rounded-lg px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700">
                {c.name}
              </a>
            ))}
          </div>
          <div class="mt-3 border-t border-slate-100 pt-3">
            <a href="/blog/" class="block rounded-lg px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700">Blog ekspercki</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
          <div>
            <p class="text-sm font-semibold text-slate-800">Specjalizacje</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              {specializations.map(s => (
                <li><a href={s.href} class="hover:text-brand-700">{s.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-800">Miasta</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              {cities.map(c => (
                <li><a href={c.href} class="hover:text-brand-700">{c.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-800">Dla kogo</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              <li><a href="/dla-dentystow/" class="hover:text-brand-700">Dla dentystow</a></li>
              <li><a href="/dla-technikow-dentystycznych/" class="hover:text-brand-700">Dla technikow</a></li>
              <li><a href="/dla-producentow-sprzetu/" class="hover:text-brand-700">Dla producentow</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-800">Portal</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              <li><a href="/blog/" class="hover:text-brand-700">Blog ekspercki</a></li>
              <li><a href="/dla-dentystow/" class="hover:text-brand-700">Dla dentystow</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 border-t border-slate-200 pt-6 text-center text-xs leading-relaxed text-slate-400">
          &copy; {new Date().getFullYear()} gdzie-konferencje.pl - Wszelkie prawa zastrzezone.<br />
          Serwis skierowany do lekarzy dentystow, technikow dentystycznych i pracownikow branzy medycznej.
        </div>
        <div class="mt-4 rounded-lg bg-slate-100 px-4 py-3 text-center text-xs leading-relaxed text-slate-400">
          <strong class="font-medium text-slate-500">Informacja o tresciach:</strong>
          Artykuly i materialy edukacyjne publikowane na gdzie-konferencje.pl tworzone sa na podstawie
          ogolnodostepnych zrodel internetowych i nie stanowia porady medycznej ani klinicznej.
          Nie sa pisane przez lekarzy ani weryfikowane przez specjalistow. Sluza wylacznie celom
          informacyjnym i edukacyjnym. W sprawach klinicznych zawsze konsultuj sie z odpowiednim specjalista.
        </div>
      </div>
    </footer>

    <script>
      // --- Disclaimer modal ---
      const modal = document.getElementById('disclaimer-modal');
      const yesBtn = document.getElementById('disclaimer-yes');
      const noBtn = document.getElementById('disclaimer-no');

      if (modal && !localStorage.getItem('gk-prof-consent')) {
        modal.classList.remove('hidden');
      }

      yesBtn?.addEventListener('click', () => {
        localStorage.setItem('gk-prof-consent', '1');
        modal?.classList.add('hidden');
      });

      noBtn?.addEventListener('click', () => {
        window.location.href = 'https://www.google.pl/';
      });

      // --- Mobile menu ---
      const toggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      toggle?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        mobileMenu?.classList.toggle('hidden', !isHidden);
        iconOpen?.classList.toggle('hidden', isHidden ?? false);
        iconClose?.classList.toggle('hidden', !isHidden);
      });
    </script>
  </body>
</html>
