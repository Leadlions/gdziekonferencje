---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, breadcrumbs, jsonLd } = Astro.props;
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <slot />
  </div>
</Base>
