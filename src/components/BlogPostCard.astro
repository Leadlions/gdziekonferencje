---
interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  tags?: string[];
  href: string;
}

const { title, description, publishedAt, tags = [], href } = Astro.props;

const dateStr = publishedAt.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={href}
  class="group block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
>
  {tags.length > 0 && (
    <div class="mb-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 2).map(tag => (
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{tag}</span>
      ))}
    </div>
  )}
  <h3 class="font-semibold leading-snug text-slate-800 group-hover:text-brand-700">{title}</h3>
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500">{description}</p>
  <p class="mt-3 text-xs text-slate-400">{dateStr}</p>
</a>
