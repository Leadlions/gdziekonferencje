---
interface Props {
  name: string;
  date: string;
  city: string;
  specialty: string;
  organizer?: string;
  url?: string;
}

const { name, date, city, specialty, organizer, url } = Astro.props;
---

<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <span class="mb-2 inline-block rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-brand-800">
        {specialty}
      </span>
      <h3 class="font-semibold text-slate-800">{name}</h3>
      <p class="mt-1 text-sm text-slate-500">{date} &middot; {city}</p>
      {organizer && <p class="mt-0.5 text-xs text-slate-400">{organizer}</p>}
    </div>
    {url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-md bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-700 transition-colors hover:bg-brand-100"
      >
        Szczeg&oacute;ły &rarr;
      </a>
    )}
  </div>
</div>
