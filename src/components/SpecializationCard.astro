---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
>
  <span class="mb-3 text-2xl">{icon}</span>
  <h3 class="font-semibold text-slate-800 group-hover:text-brand-700">{title}</h3>
  <p class="mt-1 flex-1 text-sm leading-relaxed text-slate-500">{description}</p>
  <span class="mt-3 text-xs font-medium text-brand-600 group-hover:text-brand-800">
    Zobacz konferencje &rarr;
  </span>
</a>
